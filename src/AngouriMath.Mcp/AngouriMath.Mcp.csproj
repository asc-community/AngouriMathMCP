<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <!-- Lowercase deliberately: this is what a user types and what goes into an MCP client
         config, and Linux and macOS are case-sensitive. -->
    <AssemblyName>angourimath-mcp</AssemblyName>
    <RootNamespace>AngouriMath.Mcp</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Two ways to get AngouriMath. Until 2.0.0 these were not interchangeable — the released
    1.4.0 package scored 75/117 on the corpus against the branch's 111/117, with wrong
    answers and hangs — so the choice had to be reported loudly. 2.0.0 is that branch, so the
    package is now the baseline and the sibling checkout is only ahead of it between releases.

    Preferred: a sibling checkout at ../AngouriMath, used automatically when present, so that
    this server exercises unreleased fixes.

    Fallback: the released 2.0.0 package, so cloning this repo on its own builds and behaves
    the same. Everything documented in the README and in the angourimath://reliability
    resource holds on both.

    The framework has to be pinned: the library multi-targets, and an unpinned ProjectReference
    silently fails to resolve. net7.0 is gone as of 2.0.0 — net8.0 and net10.0 replace it.
  -->
  <PropertyGroup>
    <LocalAngouriMath>$(MSBuildThisFileDirectory)../../../AngouriMath/Sources/AngouriMath/AngouriMath.csproj</LocalAngouriMath>
    <UseLocalAngouriMath Condition="Exists('$(LocalAngouriMath)')">true</UseLocalAngouriMath>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalAngouriMath)' == 'true'">
    <ProjectReference Include="$(LocalAngouriMath)">
      <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalAngouriMath)' != 'true'">
    <PackageReference Include="AngouriMath" Version="2.1.0" />
  </ItemGroup>

  <Target Name="ReportAngouriMathSource" BeforeTargets="Build">
    <Message Condition="'$(UseLocalAngouriMath)' == 'true'" Importance="high"
             Text="AngouriMathMCP: building against the local AngouriMath checkout." />
    <Message Condition="'$(UseLocalAngouriMath)' != 'true'" Importance="high"
             Text="AngouriMathMCP: no sibling AngouriMath checkout found, building against the released 2.0.0 package." />
  </Target>
</Project>
